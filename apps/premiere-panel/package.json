{
  "name": "asset-library-premiere-panel",
  "version": "0.4.4",
  "private": true,
  "description": "Asset Library panel for Adobe Premiere Pro (UXP and CEP builds).",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:cep": "node scripts/build.mjs --cep",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cep.json",
    "test": "vitest run",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "package:cep": "node scripts/build.mjs --cep && node scripts/package.mjs --cep",
    "test:harness": "node scripts/build.mjs && node scripts/build.mjs --cep && playwright test",
    "screenshot": "node scripts/build.mjs && SCREENSHOT=1 playwright test screenshot",
    "sign:cep": "node scripts/build.mjs --cep && node scripts/sign-cep.mjs"
  },
  "devDependencies": {
    "@adobe/premierepro": "26.5.1",
    "@playwright/test": "^1.64.1",
    "electron": "44.7.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.10"
  }
}
