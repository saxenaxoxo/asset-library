{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@catalog/*": ["../../packages/catalog/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "../../packages/catalog/**/*"],
  "exclude": ["tests/harness/**", "tests/*.harness.spec.ts"]
}
