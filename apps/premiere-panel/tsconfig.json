{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@catalog/*": ["../../packages/catalog/*"],
      "@host/*": ["src/host-uxp/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "../../packages/catalog/**/*"],
  "exclude": [
    "src/host-cep/**",
    "tests/cep-host.test.ts",
    "tests/host-jsx.test.ts",
    "tests/harness/**",
    "tests/*.harness.spec.ts"
  ]
}
